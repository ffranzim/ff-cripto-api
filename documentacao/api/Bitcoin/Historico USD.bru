meta {
  name: Histórico USD
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/quotes/bitcoin/history?currency=usd&days=7
  body: none
  auth: none
}

params:query {
  currency: usd
  days: 7
}

assert {
  res.status: eq 200
  res.body.source: eq coingecko
  res.body.prices: isArray
  res.body.stale: isBoolean
  res.body.currency: eq usd
}

docs {
  Mesmo endpoint, em dólar e só os últimos 7 dias.
}
