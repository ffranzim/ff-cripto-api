meta {
  name: CoinGecko
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/quotes/bitcoin/coingecko
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.usd: isNumber
  res.body.brl: isNumber
  res.body.fetched_at: isString
  res.body.source: eq coingecko
}

docs {
  Chama só este fornecedor (`internal/service/externo/coingecko`), sem fallback e sem gravar no banco. Cache em memória pelo TTL; se falhar, 503.

  Usa `COINGECKO_API_KEY` (header `x-cg-demo-api-key`) se configurada.
}
